---
// The shared <head> contents: title and description, the canonical URL, Open
// Graph and Twitter card tags, and the icons, which the endpoints in src/pages/
// draw from the art. The page uses system fonts, so it loads no web font.
import { SHARE_IMAGE, SITE_NAME } from "../lib/site";

type Props = {
  title: string;
  description: string;
  /** A plain description of the share image. */
  imageAlt: string;
  /** Keeps the page out of search results and gives it no canonical URL, as on the 404 page. */
  noindex?: boolean;
};
const { title, description, imageAlt, noindex = false } = Astro.props;
const canonical = noindex ? undefined : new URL(Astro.url.pathname, Astro.site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="color-scheme" content="light dark" />
{noindex && <meta name="robots" content="noindex" />}
{canonical && <link rel="canonical" href={canonical} />}
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL("/share.png", Astro.site).href} />
<meta property="og:image:width" content={String(SHARE_IMAGE.width)} />
<meta property="og:image:height" content={String(SHARE_IMAGE.height)} />
<meta property="og:image:type" content={SHARE_IMAGE.type} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
